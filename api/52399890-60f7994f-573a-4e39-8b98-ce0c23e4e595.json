				{
					"name": "Create Session",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 201', function () {",
									"  pm.response.to.have.status(201);",
									"});",
									"",
									"const setCookie = pm.response.headers.get('Set-Cookie');",
									"const match = setCookie && setCookie.match(/^X-Session-Id=([0-9a-f]{32});/);",
									"if (match) {",
									"  pm.collectionVariables.set('session_sid', match[1]);",
									"  pm.collectionVariables.set('expired_session_sid', match[1]);",
									"}"
								],
								"id": "04fe6be6-2301-47b0-943f-91f89b11f5ee"
							}
						}
